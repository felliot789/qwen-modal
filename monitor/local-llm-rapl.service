[Unit]
Description=Publish averaged Intel CPU and DRAM power
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/libexec/local-llm-rapl.py
RuntimeDirectory=local-llm-rapl
RuntimeDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
